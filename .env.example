# HalimiSOC server configuration.
#
# Copy to .env and adjust. Values shown are development defaults; every one of
# them must be changed before any deployment that is reachable by someone else.
# See docs/security/configuration.md for the reasoning behind each setting.

# --- Core -----------------------------------------------------------------

# "production" enables strict requirements: secure cookies, a strong admin
# password and a long enrollment secret are enforced and the process refuses to
# start without them.
HALIMISOC_ENV=development

# Bind to loopback by default. Expose the API through a TLS-terminating reverse
# proxy rather than binding it to a public interface directly.
HALIMISOC_LISTEN_ADDR=127.0.0.1:8080

HALIMISOC_DATABASE_URL=postgres://halimisoc:halimisoc_dev_pw@127.0.0.1:5432/halimisoc?sslmode=disable

# Directory holding detection rule YAML files.
HALIMISOC_RULES_PATH=packages/rules

HALIMISOC_LOG_LEVEL=info

# --- Credentials ----------------------------------------------------------

# Used only to create the first administrator when no account exists. Remove it
# from the environment after bootstrap.
HALIMISOC_ADMIN_USER=admin
HALIMISOC_ADMIN_PASSWORD=change-me-before-deploying

# Shared bootstrap credential for agent enrollment. Minimum 24 characters in
# production. Rotating it does not invalidate already-issued agent tokens.
HALIMISOC_AGENT_ENROLL_SECRET=change-me-before-deploying-too

# Mark session cookies Secure and use the __Host- prefixed cookie name. Required
# in production; requires the API to be served over HTTPS.
HALIMISOC_SECURE_COOKIES=false

# Session lifetime. Longer sessions increase the window in which a stolen cookie
# is useful, so this is deliberately hours rather than days.
HALIMISOC_SESSION_TTL=12h

# Accepted absolute difference between an agent-reported event time and the
# server receipt time. Events further in the future are rejected.
HALIMISOC_CLOCK_SKEW=5m

# --- Bounds ---------------------------------------------------------------
# Every bound has a built-in safe default and a hard maximum. Values above the
# maximum are clamped, not rejected, so a typo cannot make the server unbounded.

HALIMISOC_MAX_HTTP_BODY_BYTES=4194304
HALIMISOC_MAX_EVENT_BATCH=1000
HALIMISOC_MAX_EVENT_FIELD_BYTES=4096
HALIMISOC_MAX_RAW_LINE_BYTES=8192
HALIMISOC_MAX_MULTILINE_BYTES=65536
HALIMISOC_MEMORY_QUEUE=10000
HALIMISOC_DISK_SPOOL_BYTES=104857600
HALIMISOC_MAX_DB_ROWS=10000
HALIMISOC_PAGE_SIZE=50

# --- Retention ------------------------------------------------------------

# Raw evidence is the first thing to expire; the structured event is kept so
# alert and incident references remain valid.
HALIMISOC_RAW_RETENTION_HOURS=72
HALIMISOC_EVENT_RETENTION_HOURS=720

# --- AI (optional, MVP) ---------------------------------------------------
# Detection and correlation never depend on these. Missing credentials disable
# AI features and leave the rest of the pipeline fully functional.

# HALIMISOC_AI_BASE_URL=http://127.0.0.1:11434/v1
# HALIMISOC_AI_API_KEY=
# HALIMISOC_AI_MODEL=
# HALIMISOC_MAX_AI_CONTEXT_BYTES=65536
# HALIMISOC_MAX_AI_CONCURRENT=2

# --- Webhook (optional) -----------------------------------------------------
# One incident.created POST per new incident. Merges never notify. The payload
# carries incident scope only, never raw evidence. Empty disables delivery.

# HALIMISOC_WEBHOOK_URL=https://hooks.example.test/halimisoc
# HALIMISOC_WEBHOOK_TIMEOUT=5s

# --- Development only -----------------------------------------------------

# Run without PostgreSQL using in-memory storage. Data is lost on restart and no
# durability guarantee applies. Never enable this for a real deployment.
# HALIMISOC_ALLOW_MEMORY_STORE=false
