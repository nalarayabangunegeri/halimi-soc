# Where the dashboard reaches the HalimiSOC API.
#
# This address is used server-side only. The browser never sees it and cannot
# reach it: all API calls are proxied through this app's own route handlers, which
# also hold the API session cookie.
HALIMISOC_API_URL=http://127.0.0.1:8080

# Must match the API's HALIMISOC_SECURE_COOKIES. The API names its session cookie
# __Host-halimisoc_session when secure, and halimisoc_session otherwise.
HALIMISOC_API_SECURE_COOKIES=false

# Name of the cookie this app sets for the browser session. It is separate from
# the API's cookie on purpose: the API session is held by this server, so a
# stolen browser cookie cannot be replayed directly against the API.
HALIMISOC_WEB_COOKIE=halimisoc_web_session

# Set to "true" when the dashboard is served over HTTPS. It defaults to true in a
# production build, which marks the session cookie Secure and restricts it to HTTPS.
HALIMISOC_WEB_SECURE_COOKIES=false

# Acknowledges that the dashboard is served over plain HTTP.
#
# A production build refuses to serve with an insecure cookie unless this is set,
# because the alternative is a session cookie sent in cleartext. Set it only for a
# lab, a training environment on a trusted network, or the end-to-end test, and
# understand that it removes the transport protection on the session cookie.
HALIMISOC_WEB_ALLOW_INSECURE_COOKIES=false

# Set to "production" to enable the strict startup checks.
NODE_ENV=development
